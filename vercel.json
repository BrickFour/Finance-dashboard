{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix server && npm ci --prefix client",
  "buildCommand": "npm run build --prefix client && npm run build --prefix server",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.mjs": {
      "includeFiles": "{server/dist/**,server/assets/**,server/package.json,dhyeya-demo-data.zip}",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
