# Deployment settings read by docker-compose.yml. Copy to ".env" (git-ignored).

# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# REQUIRED. Password for the first administrator (used on first start only).
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=admin@dhyeya.local

# Public origin(s) of the site, comma separated. Match your real URL.
CORS_ORIGIN=http://localhost:4000
HOST_PORT=4000

# Read-only demo company built from dhyeya-demo-data.zip on first start.
# Set to false once real clients no longer need the sample.
DEMO_DATA=true

# Only with docker-compose.postgres.yml
# POSTGRES_PASSWORD=

# Demo login created at startup (admin role). Set DEMO_LOGIN=false to disable.
# DEMO_LOGIN_EMAIL=suvidha.deshmukh@brickfour.com
# DEMO_LOGIN_PASSWORD=Suvidha@123

